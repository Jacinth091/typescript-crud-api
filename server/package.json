{
  "name": "typescript-crud-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:dev": "nodemon --exec ts-node -r tsconfig-paths/register src/server.ts",
    "test:manual": "ts-node -r tsconfig-paths/register tests/manual/runner.ts",
    "test:log": "ts-node -r tsconfig-paths/register scripts/test-api.ts",
    "db:seed-admin": "ts-node -r tsconfig-paths/register scripts/seed-admin.ts",
    "db:seed-data": "ts-node -r tsconfig-paths/register scripts/seed-data.ts",
    "db:seed": "npm run db:seed-admin && npm run db:seed-data"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "joi": "^18.1.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.20.0",
    "rootpath": "^0.1.2",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2"
  }
}